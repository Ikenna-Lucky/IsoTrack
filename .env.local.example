# Frontend URL. Use the deployed HTTPS URL when hosting.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend base URL for API requests and live tracking; do not append /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional MapTiler browser key. Leave blank to use OpenStreetMap.
# This key is public; restrict it to your frontend domains in MapTiler.
NEXT_PUBLIC_MAPTILER_KEY=
