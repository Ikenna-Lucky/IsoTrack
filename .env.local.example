# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=IsoTrack

# ─── Backend API ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── Paystack ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# ─── MapLibre / OpenStreetMap ─────────────────────────────────────────────────
# No API key needed — OpenStreetMap tiles are free and open
NEXT_PUBLIC_MAPTILER_KEY=optional_for_custom_styled_tiles
